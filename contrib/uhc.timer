# Managed by ubuntu-health-check: change it with --install-timer, remove it with --remove-timer.
# ubuntu-health-check timer-format 1
# Frequency: monthly

[Unit]
Description=Ubuntu Health Check, monthly

[Timer]
# 1st day of each month at 10:00, within 15 minutes.
OnCalendar=*-*-01 10:00:00
RandomizedDelaySec=15min
# If the machine was off at that time, run at the next session start.
Persistent=true

[Install]
WantedBy=timers.target
